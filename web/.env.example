# Neon Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Long random string used to sign login sessions and hash OTPs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456:replace-me"
# Your bot's username WITHOUT the @ (used for the "Connect Telegram" link)
TELEGRAM_BOT_USERNAME="@zego23Bot"
# Any random string; Telegram sends it back so we know webhook calls are genuine
TELEGRAM_WEBHOOK_SECRET="another-random-string"

# Public URL of this web app (used when registering the Telegram webhook)
APP_URL="http://localhost:3000"

# Security tuning (optional)
OTP_TTL_SECONDS=120
CHALLENGE_TTL_SECONDS=60
MAX_ATTEMPTS=3
UNLOCK_SECONDS=5
